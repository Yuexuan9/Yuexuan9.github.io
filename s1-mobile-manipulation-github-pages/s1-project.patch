+      node("se2-base").setAttribute("transform", `translate(${anchor.x} ${anchor.y}) rotate(${-values.heading})`);
+      node("se2-target").setAttribute("transform", `translate(${targetScreen.x} ${targetScreen.y}) rotate(${-target.yaw / rad})`);
+      node("se2-trajectory").setAttribute("d", `M ${anchor.x} ${anchor.y} L ${targetScreen.x} ${targetScreen.y}`);
+
+      [1, 2].forEach((step) => {
+        const ratio = step / 3;
+        const intermediate = composeSE2(reference, {
+          x: relative.x * ratio,
+          y: relative.y * ratio,
+          yaw: relative.yaw * ratio,
+        });
+        setPosition(node(`se2-point-${step}`), screen(intermediate));
+      });
+
+      const c = Math.cos(reference.yaw);
+      const s = Math.sin(reference.yaw);
+      setLabelPosition(node("se2-body-x"), anchor.x + 90 * c, anchor.y - 90 * s + 4);
+      setLabelPosition(node("se2-body-y"), anchor.x - 84 * s, anchor.y - 84 * c + 4);
+
+      const arcRadius = 49;
+      const arcEnd = { x: anchor.x + arcRadius * c, y: anchor.y - arcRadius * s };
+      node("se2-heading-arc").setAttribute(
+        "d",
+        Math.abs(values.heading) < 0.1
+          ? ""
+          : `M ${anchor.x + arcRadius} ${anchor.y} A ${arcRadius} ${arcRadius} 0 0 ${values.heading > 0 ? 0 : 1} ${arcEnd.x} ${arcEnd.y}`
+      );
+
+      const label = node("se2-target-label");
+      const labelOnLeft = targetScreen.x > 470;
+      const labelBelow = targetScreen.y < 66;
+      setLabelPosition(label, targetScreen.x + (labelOnLeft ? -17 : 17), targetScreen.y + (labelBelow ? 28 : -18));
+      label.setAttribute("text-anchor", labelOnLeft ? "end" : "start");
+      label.textContent = copy.target;
+    }
+
+    Object.values(controls).forEach((control) => control.addEventListener("input", update));
+    const reset = byId("demo-reset");
+    const quarter = byId("demo-quarter");
+    if (reset) reset.addEventListener("click", () => {
+      Object.entries(defaults).forEach(([key, value]) => { controls[key].value = value; });
+      update();
+    });
+    if (quarter) quarter.addEventListener("click", () => {
+      controls.heading.value = 90;
+      update();
+    });
+    window.addEventListener("languagechange", update);
+    update();
+  }
+
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", initialize, { once: true });
+  } else {
+    initialize();
+  }
+})();
+
+</script>
+</body>
+</html>
